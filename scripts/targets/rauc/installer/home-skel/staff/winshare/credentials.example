# Учётные данные для доступа к сетевой папке Windows (SMB/CIFS).
#
# Активировать: скопировать в credentials (без .example), заполнить и выставить
# права 600 (иначе пароль виден; скрипт монтирования сам поставит 600):
#   cp credentials.example credentials
#   chmod 600 credentials
#
# Нужен только при GUEST=0 в winshare.conf.

username=WINUSER
password=WINPASS
# Для рабочей группы можно оставить WORKGROUP или удалить строку.
domain=WORKGROUP